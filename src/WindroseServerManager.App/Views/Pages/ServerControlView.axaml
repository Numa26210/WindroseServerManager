<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WindroseServerManager.App.ViewModels"
             xmlns:svc="using:WindroseServerManager.App.Services"
             x:Class="WindroseServerManager.App.Views.Pages.ServerControlView"
             x:DataType="vm:ServerControlViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="0">
        <TextBlock Classes="page-title" Text="{DynamicResource ServerControl.Title}" />
        <TextBlock Classes="caption muted" Text="{DynamicResource ServerControl.Subtitle}" Margin="0,4,0,20" />

        <!-- Active automation summary (read-only) -->
        <Border Classes="card" Margin="0,0,0,16" IsVisible="{Binding HasAutomationSummary}">
            <StackPanel Spacing="8">
                <TextBlock Classes="section-header" Text="{DynamicResource ServerControl.ActiveAutomation}" />
                <TextBlock Classes="body" Text="{Binding AutomationSummaryLine1}"
                           IsVisible="{Binding AutomationSummaryLine1, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="body" Text="{Binding AutomationSummaryLine2}"
                           IsVisible="{Binding AutomationSummaryLine2, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="{DynamicResource ServerControl.AutomationEditHint}" />
            </StackPanel>
        </Border>

        <Border Classes="card" Margin="0,0,0,16">
            <Grid RowDefinitions="Auto,*" MaxHeight="260">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Classes="section-header" Text="{DynamicResource ServerControl.SessionHistory}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="subtle"
                            Command="{Binding ClearSessionHistoryCommand}"
                            ToolTip.Tip="{DynamicResource ServerControl.ClearHistory.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="{DynamicResource ServerControl.Clear}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                            Background="{Binding Type, Converter={x:Static vm:ServerEventTypeToBrushConverter.Instance}}"
                                            VerticalAlignment="Top" Margin="0,2,10,0">
                                        <TextBlock Text="{Binding Type, Converter={x:Static vm:ServerEventTypeToIconConverter.Instance}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Classes="body" FontWeight="SemiBold"
                                                   Text="{Binding ., Converter={x:Static vm:ServerEventToTitleConverter.Instance}}" />
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="{Binding ., Converter={x:Static vm:ServerEventToDetailConverter.Instance}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="{DynamicResource ServerControl.NoEventsYet}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrandTextMutedBrush}"
                           IsVisible="{Binding Events.Count, Converter={x:Static vm:CountToInverseBoolConverter.Instance}}" />
            </Grid>
        </Border>

        <!-- Restart Enhancements -->
        <Border Classes="card" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <TextBlock Classes="section-header" Text="{DynamicResource ServerControl.RestartOptions}" />
                <CheckBox Content="{DynamicResource ServerControl.UpdateBeforeRestart}"
                          IsChecked="{Binding RestartInstallUpdateBeforeStart}" />
                <CheckBox Content="{DynamicResource ServerControl.BackupBeforeRestart}"
                          IsChecked="{Binding RestartCreateBackupBeforeStart}" />
                <CheckBox Content="{DynamicResource ServerControl.BroadcastBeforeRestart}"
                          IsChecked="{Binding RestartBroadcastEnabled}" />
                <StackPanel Spacing="4" IsVisible="{Binding RestartBroadcastEnabled}">
                    <TextBox Text="{Binding RestartBroadcastMessage}"
                             PlaceholderText="{Binding BroadcastMessagePlaceholder}" />
                    <TextBlock Classes="caption" Text="{DynamicResource ServerControl.BroadcastMessage.Hint}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
